<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/talk_pressed" />
            <stroke android:width="8dp" android:color="#55C62828" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/talk" />
            <stroke android:width="8dp" android:color="#331565C0" />
        </shape>
    </item>
</selector>
